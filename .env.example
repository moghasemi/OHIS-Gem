# ==============================================================================
# OHIS — Occupational Health Information System
# Environment Configuration Template (.env.example)
# IMPORTANT: DO NOT commit real secrets or production passwords to version control.
# Copy this file to .env and provide secure, unique values for your environment.
# ==============================================================================

# --- Django Security ---
# In production, SECRET_KEY must be a cryptographically secure 50+ character string.
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-in-production
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,api.ohis.local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL Database ---
POSTGRES_DB=ohis_db
POSTGRES_USER=ohis_admin
POSTGRES_PASSWORD=replace-with-a-secure-database-password
DB_HOST=postgres
DB_PORT=5432

# --- Redis Cache & Celery Broker ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Web & Applet Configuration ---
APP_URL=http://localhost:3000
